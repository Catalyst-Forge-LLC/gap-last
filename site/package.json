{
  "name": "gaplast-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync": "node ../scripts/sync-skill-static.mjs && node ../scripts/sync-paper-page.mjs",
    "dev": "pnpm sync && localslip claim gaplast-site --port 5200 && filepress dev --host 0.0.0.0",
    "build": "pnpm sync && filepress build",
    "preview": "filepress preview",
    "check": "filepress check",
    "ship": "pnpm build && wrangler pages deploy build --project-name=gaplast",
    "deploy": "pnpm ship"
  },
  "devDependencies": {
    "getfilepress": "^0.1.38",
    "wrangler": "^4.28.0"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.35.4",
      "cookie@<0.7.0": "0.7.2"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "getfilepress",
      "workerd"
    ]
  }
}
