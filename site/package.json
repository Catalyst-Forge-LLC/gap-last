{
  "name": "gaplast-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "sync": "node ../scripts/sync-skill-static.mjs",
    "dev": "pnpm sync && node ../scripts/ensure-lease.mjs gaplast-site 5200 && filepress dev --host 0.0.0.0",
    "build": "pnpm sync && filepress build",
    "preview": "filepress preview",
    "check": "filepress check",
    "ship": "pnpm build && wrangler pages deploy build --project-name=gaplast",
    "deploy": "pnpm ship"
  },
  "devDependencies": {
    "getfilepress": "^0.1.28",
    "wrangler": "^4.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "getfilepress",
      "workerd"
    ]
  }
}
