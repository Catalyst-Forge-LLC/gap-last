{
  "name": "gaplast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Don't invent a cause until you can name the gap. Constraint-first reconstruction: validate and emit the nine-section artifact.",
  "license": "MIT",
  "author": "Catalyst Forge LLC",
  "keywords": [
    "gap-last",
    "reconstruction",
    "constraint-first",
    "postmortem",
    "skill"
  ],
  "homepage": "https://gaplast.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/gap-last.git"
  },
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/gap-last/issues"
  },
  "bin": {
    "gaplast": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/*.test.js",
    "!dist/*.test.d.ts",
    "skills",
    "docs/reconstruction-template.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/index.test.js",
    "prepublishOnly": "node -e \"console.error('Do not publish from this tree. Sam publishes.'); process.exit(1)\""
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
